// Revison
#define VNPU_REVISION_A 0x1
#define VNPU_REVISION_B 0x2

// Capabilities
#define SUP 					1U //supported
#define NOSUP 					0U //unsupported
#define CAP_DOT_INT8 			((SUP) << 0)
#define CAP_JOB_ID 				((SUP) << 1)
#define CAP_VARIABLE_LENGTH 	((NOSUP) << 2)
#define CAP_SEPARATE_ERROR_IRQ 	((SUP) << 3)
#define CAP_FAULT_INJECTION 	((SUP) << 4)
#define CAPABILITIES 			(CAP_DOT_INT8 | CAP_JOB_ID | CAP_VARIABLE_LENGTH | CAP_SEPARATE_ERROR_IRQ | CAP_FAULT_INJECTION)
// Control
#define CONTROL_START 0x0
#define CONTROL_RESET 0x1

// Status
#define STATUS_IDLE 0x0
#define STATUS_BUSY 0x1
#define STATUS_DONE 0x2
#define STATUS_ERROR 0x3

// IRQ Status
#define IRQ_COMLETION 0x0
#define IRQ_ERROR 0x1

// Error Code
#define VNPU_ERR_NONE 0x0
#define VNPU_ERR_INVALID_LENGHT 0x1
#define VNPU_ERR_BUSY 0x2
#define VNPU_ERR_FORCED 0x3
#define VNPU_ERR_UNSUPPORTED_REVISION 0x4
#define VNPU_ERR_INTERNAL 0x5
typedef struct VnpuState VnpuState;
DECLARE_INSTANCE_CHECKER(VnpuState, VNPU, TYPE_PCI_VNPU_DEVICE)

struct VnpuState {
	PCIDevice pdev;
	MemoryRegion mmio;
	bool stopping;
	uint32_t status;

	int8_t input_a[4];
	int8_t input_b[4];
	int32_t result;

	QemuThread thread;
	QemuMutex thr_mutex;
	QemuCond thr_cond;
	bool stopping;

	uint32_t irq_status;


};

static bool edu_msi_enabled(EduState *edu)
{
    return msi_enabled(&edu->pdev);
}

static void edu_raise_irq(EduState *edu, uint32_t val)
{
    edu->irq_status |= val;
    if (edu->irq_status) {
        if (edu_msi_enabled(edu)) {
            msi_notify(&edu->pdev, 0);
        } else {
            pci_set_irq(&edu->pdev, 1);
        }
    }
}

static void edu_lower_irq(EduState *edu, uint32_t val)
{
    edu->irq_status &= ~val;

    if (!edu->irq_status && !edu_msi_enabled(edu)) {
        pci_set_irq(&edu->pdev, 0);
    }
}

static void edu_check_range(uint64_t xfer_start, uint64_t xfer_size,
                uint64_t dma_start, uint64_t dma_size)
{
    uint64_t xfer_end = xfer_start + xfer_size;
    uint64_t dma_end = dma_start + dma_size;

    /*
     * 1. ensure we aren't overflowing
     * 2. ensure that xfer is within dma address range
     */
    if (dma_end >= dma_start && xfer_end >= xfer_start &&
        xfer_start >= dma_start && xfer_end <= dma_end) {
        return;
    }

    qemu_log_mask(LOG_GUEST_ERROR,
                  "EDU: DMA range 0x%016"PRIx64"-0x%016"PRIx64
                  " out of bounds (0x%016"PRIx64"-0x%016"PRIx64")!",
                  xfer_start, xfer_end - 1, dma_start, dma_end - 1);
}

static uint64_t vnpu_mmio_read(void *opaque, hwaddr addr, unsigned size)
{
    edustate *edu = opaque;
    uint64_t val = ~0ULL;
	
	if(size != 4){
		return val;
	}

	switch (addr) {
	case 0x000:
		val = 0x564E5055;
		break;
	case 0x004:
		val = REV;
		break;
	case 0x008:
		val = CAP;
		break;
	case 0x010:
		val = STATUS;
		break;
	case 0x014:
		val = IRQ_STATUS;
		break;
	case 0x018:
		val = IRQ_ENABLE;
		break;
	case 0x01C:
		val = ERROR_CODE;
		break;
	case 0x020:
		val = JOB_ID;
		break;
	case 0x024:
		val = VECTOR_LENGTH;
		break;
	case 0x100:
		val = *INPUT_A;
		break;
	case 0x120:
		val = *INPUT_B;
		break;
	case 0x140:
		val = RESULT;
		break;
	case 0x180:
		val = FAULT_CONTROL;
		break;

	}
	return val;
}

static void vnpu_mmio_write(void *opaque, hwaddr addr, uint64_t val,
                unsigned size)
{

    VnpuState *vnpu = opaque;
	uint32_t val = ~0ULL;

	if(size !=4) {
		return val;
	}
	switch (addr) {
		case 0x00C: //CONTROL
			if(val){
				vnpu->status = STATUS_IDLE;
				//reset_vnpu_status_thread();
				break;
			}
			if(!(vnpu->status)){
				break;
				//raise_irq();??
				/* Device is not idle. */
			}
			vnpu->status = STATUS_BUSY;
			qemu_mutex_lock(&vnpu->thr_mutex);
			qemu_cond_signal(&vnpu->thr_cond);
			qemu_mutex_unlock(&vnpu->thr_mutex);
			/* start thread.*/

			break;
		case 0x014: //IRQ_STATUS
			break;
		case 0x018: //IRQ_ENABLE
			break;
		case 0x020: //JOB_ID
			break;
		case 0x024: //VECTOR_LENGTH
			break;
		case 0x100: //write INPUT_A
			break;
		case 0x120: //write INPUT_B
			break;
		case 0x180: //write FAULT_CONTROL
			break;

	}
}


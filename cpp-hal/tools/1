struct DotInput {
	std::span<const std::int8_t> input_a;
	std::span<const std::int8_t> input_b;
	std::chrono::milliseconds timeout;
};

void print_usage(int num){

	if(num == 1){
		std::cerr
			<<"Usage:\n"
			<< "vnpuctl <command> <input file>";
	}
	else if(num == 2){
		std::cerr
			<<"Usage:\n"
			<< "vnpuctl info --json\n"
			<< "vnpuctl run-dot --input json.file --json\n"
			<< "vnpuctl inject-fault irq-drop\n"
			<< "vnpuctl inject-fault stuck-busy\n"
			<< "vnpuctl inject-fault corrupt-result\n"
			<< "vnpuctl inject-fault force-error\n"
			<< "vnpuctl clear-faults\n"
			<< "vnpuctl reset\n"
			<< "vnpuctl stats --json\n";
	}
}

static std::string get_option(int argc, char** argv, std::string_view option)
{
	for (int i = 2; i + 1 < argc; ++i) {
			if (argv[i] == option) {
					return argv[i + 1];
			}
	}

	throw std::runtime_error(std::string("missing option: ") + std::string(option));
}

bool has_falg(int argc, char** argv, std::string_view flag){

	for(int i = 2; i<argc; i++){
		if(argv[i] == flag){
			return true;
		}
	}
	return false;
}

static std::vector<std::int8_t> parse_int8_array(const nlohmann::json& root, const char* field)
{
	if (!root.contains(field) || !root[field].is_array()) {
			throw std::runtime_error(std::string("missing or invalid field: ") + field);
	}

	const auto& arr = root[field];

	if (arr.size() != 8) {
			throw std::runtime_error(std::string(field) + " must contain exactly 8 elements");
	}

	std::vector<std::int8_t> out;
	out.reserve(arr.size());

	for (const auto& value : arr) {
			if (!value.is_number_integer()) {
					throw std::runtime_error(std::string(field) + " must contain only integers");
			}

			const int v = value.get<int>();

			if (v < -128 || v > 127) {
					throw std::runtime_error(std::string(field) + " value out of int8 range");
			}

			out.push_back(static_cast<std::int8_t>(v));
	}

	return out;
}

static DotInput parse_run_dot_input_json(const std::string& path)
{
	std::ifstream file(path);
	if (!file) {
			throw std::runtime_error("failed to open: " + path);
	}

	nlohmann::json root;
	file >> root;

	RunDotInput input;
	input.input_a = parse_int8_array(root, "input_a");
	input.input_b = parse_int8_array(root, "input_b");

	if (input.input_a.size() != input.input_b.size()) {
			throw std::runtime_error("input_a and input_b length mismatch");
	}

	if (!root.contains("timeout_ms") || !root["timeout_ms"].is_number_integer()) {
			throw std::runtime_error("missing or invalid field: timeout_ms");
	}

	const int timeout_ms = root["timeout_ms"].get<int>();
	if (timeout_ms <= 0) {
			throw std::runtime_error("timeout_ms must be positive");
	}

	input.timeout = std::chrono::milliseconds(timeout_ms);
	return input;
}

int main(int argc, char** argv){
	if(argc <2){
		print_usage(1);
		return 0;
	}

	const std:string_view command = argv[1];
	CliOptions options();



	if(command == "info"){
		struct DeviceInfo info;
		info = dev.vnpu_get_info();

		if(json){
			std::cout
				<< "{\n"
				<< "\tabi_version :" << info.abi_version << ",\n" 
				<< "\tdevice_id :" << info.device_id << ",\n" 
				<< "}\n";
		} else {
			std::cout
				<< "\tabi_version :" << info.abi_version << ",\n" 
				<< "\tdevice_id :" << info.device_id << ",\n" ;
		}
		
		return 0;
	}

	if(command == "run-dot"){
		struct DotProductResult dot;
		const std::string input_path = get_option(argc, argv, "--input")

		DotInput input = parse_run_dot_input_json(input_path);

		dot = dev.vnpu_run_dot(input.input_a, input.input_b, input.timeout);

		if(json){
			std::cout
				<< "{\n"
				<< "\tresult :" << dot.result << ",\n" 
				<< "\tdevice_error :" << dot.device_error << ",\n" 
				<< "\tstatus :" << dot.status << ",\n" 
				<< "}\n";
		} else {
			std::cout
				<< "\tresult :" << dot.result << ",\n" 
				<< "\tdevice_error :" << dot.device_error << ",\n" 
				<< "\tstatus :" << dot.status << ",\n";
		}

		return 0;
	}

	if(command == "inject-fault"){
		
		uint32_t fault_mask;

		if(argv[2] == "irq-drop"){
			dev.vnpu_set_fault(FaultType.irq_drop);
		} else if(argv[2] == "stuck-busy"){
			dev.vnpu_set_fault(FaultType.stuck_busy);
		} else if(argv[2] == "corrupt-result"){
			dev.vnpu_set_fault(FaultType.corrupt_result);
		} else if(argv[2] == "force-error"){
			dev.vnpu_set_fault(FaultType.force_error);
		}
		
		std::cout << "set fault mask\n";
	}

	if(command == "clear-fault"){
		uint32_t fault_mask;
		dev.vnpu_set_fault(0);
		std::cout << "clear fault mask\n";
	}

	if(command == "reset"){
		dev.vnpu_reset();
		std::cout << "device reset\n";
	}

	if(command == "stats"){

		struct DeviceStats stats;
		stats = dev.vnpu_get_stats();

		if(json){
			std::cout
				<< "{\n"
				<< "\tsubmitted :" << stats.submitted << ",\n" 
				<< "\tcomplted :" << stats.completed << ",\n" 
				<< "\ttimed_out :" << stats.timed_out << ",\n" 
				<< "\tdevice_error :" << stats.device_error << ",\n" 
				<< "\tresets :" << stats.resets << ",\n" 
				<< "}\n";
		} else {
			std::cout
				<< "\tsubmitted :" << stats.submitted << ",\n" 
				<< "\tcomplted :" << stats.completed << ",\n" 
				<< "\ttimed_out :" << stats.timed_out << ",\n" 
				<< "\tdevice_error :" << stats.device_error << ",\n" 
				<< "\tresets :" << stats.resets << ",\n";
		}
	}
	return 0;
}
